+// Exact sRGB decode (IEC 61966-2-1), component-wise: a display code / 255 -> its linear value (debug views, captures)
+float3 NocSrgbToLinear(float3 c)
+{
+    float3 lo = c / 12.92;
+    float3 hi = pow(abs((c + 0.055) / 1.055), 2.4);
+    return c <= 0.04045 ? lo : hi;
+}
