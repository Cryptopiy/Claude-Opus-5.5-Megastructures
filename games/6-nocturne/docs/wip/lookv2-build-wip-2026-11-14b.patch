+        _FineSize ("Fine leaf cell (m)", Float) = 0.35
+        _Contrast ("Leaf contrast", Range(0, 4)) = 1.8
+        _GlowGain ("Leaf glow gain (x LeafGlow)", Float) = 0.042
+        _TipGain ("Tip glow gain (x LeafWarm)", Float) = 0.08
