+            double c2 = NocMirrorMath.WallReflect(P, r0, 0.1, 10, 4e-4, one, 1, true, sky, out D3 k2);
+            Assert.AreEqual(c1, c2, 1e-12);
+            Assert.AreEqual(k1.x, k2.x, 1e-12);
+        }
