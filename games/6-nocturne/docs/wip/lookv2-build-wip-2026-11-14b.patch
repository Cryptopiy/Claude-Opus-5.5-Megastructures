+                    {
+                        var m = f.GetValue(lib) as Material;
+                        if (m == null || m.shader == null) continue;
+                        for (int p = 0; p < m.passCount; p++) ShaderUtil.CompilePass(m, p, true);
+                    }
+                foreach (var name in shaderNames)
