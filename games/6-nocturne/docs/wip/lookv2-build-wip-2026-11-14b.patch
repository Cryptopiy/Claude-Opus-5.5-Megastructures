+                                continue;
+                            }
+                            if (!QaProjection.ProjectPoint(v, pts[i], out double nx, out double ny)) { if (!hidden[i] && !r.shot.koiBody) { ka.outside++; ka.minMargin = Math.Min(ka.minMargin, -1.0); } continue; }
