+                double phiH = KoiMath.HeadAzimuth(KoiMath.PhaseU(pr.s));
+                for (int ph = 0; ph < KoiMath.WavePhases; ph++)
+                {
+                    KoiMath.Samples(phiH, KoiMath.PhaseWaveTime(ph), pts);
+                    for (int i = 0; i < pts.Length; i++)
+                    {
