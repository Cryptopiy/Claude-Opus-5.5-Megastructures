+                    double m1 = PatchMean(sb, fw, 1.0, shift.Item1, shift.Item2, 1000.0, 240.0, 10.0, 172.8, out double g1);
+                    double m0 = PatchMean(sb, fw, 0.0, shift.Item1, shift.Item2, 1000.0, 240.0, 10.0, 172.8, out double g0);
+                    double rel = Math.Abs(m1 - m0) / Math.Max(m0, 1e-12), relG = Math.Abs(g1 - g0) / Math.Max(g0, 1e-12);
+                    Debug.Log(FormattableString.Invariant($"[FA] V2 w forced 0 / 1: byte {sb} skin {NocFacadeMath.SkinOf(sb).id} shift ({shift.Item1}, {shift.Item2}): emission {m0:E4} / {m1:E4} ({100 * rel:F2} %), glass {g0:F4} / {g1:F4} ({100 * relG:F2} %)"));
+                    Assert.Less(rel, 0.03, "emission means of w = 0 and w = 1 within 3 %");
+                    Assert.Less(relG, 0.03, "glass coverage means of w = 0 and w = 1 within 3 %");
+                }
+            }
+            // grazing: huge shifts, tiny and huge footprints
+            foreach (double k in new[] { 50.0, 1000.0, -1000.0 })
+                foreach (double f in new[] { 1e-3, 0.3, 50.0 })
+                {
+                    var q = Patch(17, f, -1.0, k, -k, 0.2, 0.3);
+                    q.u = 1234.5; q.v = 77.7;
+                    var o = NocFacadeMath.EvalV2(q);
+                    Assert.IsFalse(double.IsNaN(o.emission.r + o.emission.g + o.emission.b + o.aGlass + o.aOpen), "no NaN at grazing");
