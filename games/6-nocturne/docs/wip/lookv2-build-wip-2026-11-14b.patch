+        // Look v2 (TEXTURE_PLAN 3.3, CRIT0 #8): a near wall plane ends in front of a far one (a canyon block and the face behind it).
+        // v1 lets the near wall take over as soon as its soft end has any coverage, so the far wall's reflection is replaced by the
+        // sky in one sample: a vertical seam at the near wall's vanishing line. v2 composites the near wall over the far one and
+        // widens the end blend to at least 2.5 deg, so the reflected radiance is continuous.
+        [Test]
+        public void WallBlend_V1Seam_V2Continuous()
+        {
+            var walls = new[]
+            {
+                new NocMirrorMath.WallPlane { cx = 20, cz = 40, nx = -1, nz = 0, halfLength = 40, top = 60, kind = 1, weight = 1, colour = new D3(0.03, 0.03, 0.03) },
+                new NocMirrorMath.WallPlane { cx = 60, cz = 200, nx = -1, nz = 0, halfLength = 300, top = 200, kind = 1, weight = 1, colour = new D3(0.05, 0.05, 0.05) },
+            };
+            var sky = new D3(0.01, 0.01, 0.01);
+            var P = new D3(0, 0, 10);
+            double MaxStep(bool v2, double soft)
+            {
+                double prev = double.NaN, maxStep = 0;
+                for (int k = 0; k <= 2000; k++)
+                {
+                    double az = (10.0 + k * 0.01) * Math.PI / 180.0;          // azimuth from +z toward +x: 10 .. 30 deg (the near end at 15.9 deg)
+                    var r = new D3(Math.Sin(az) * Math.Cos(0.05), Math.Sin(0.05), Math.Cos(az) * Math.Cos(0.05));
+                    double a = NocMirrorMath.WallReflect(P, r, soft, 10, 4e-4, walls, walls.Length, v2, sky, out D3 c);
+                    double v = sky.x + (c.x - sky.x) * a;
+                    if (!double.IsNaN(prev)) maxStep = Math.Max(maxStep, Math.Abs(v - prev));
+                    prev = v;
+                }
+                return maxStep;
+            }
+            const double soft = 0.01;                                             // a sharp puddle lobe (0.6 deg)
+            double v1 = MaxStep(false, soft), v2 = MaxStep(true, soft);
+            Assert.Greater(v1, 0.01, "v1 has the seam (the far wall replaced by the sky in one 0.01 deg step)");
+            Assert.Less(v2, 3e-4, "v2: at most 0.6 % of the wall radiance per 0.01 deg step (the 5 deg blend: 0.02 over about 140 steps)");
