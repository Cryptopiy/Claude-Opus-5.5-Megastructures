+                    double rb = c.r / Math.Max(c.b, 1e-6);
+                    cls[rb > 3.5 ? 0 : (rb > 2.0 ? 1 : (rb > 1.05 ? 2 : (rb > 0.45 ? 3 : 4)))]++;
