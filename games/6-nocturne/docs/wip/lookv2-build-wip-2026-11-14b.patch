-namespace Megastructure
-{
-    public enum VisRule { Info = 0, Whole = 1, Part = 2 }
-
-    /// <summary>Frame-composition check of a shot (ray grid over the frame).</summary>
-    public enum VisComposition { None = 0, Drop = 1, Strip = 2, Wall = 3 }
