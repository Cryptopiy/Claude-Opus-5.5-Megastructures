+        static List<D3> SpirePoints(D3 eye)
+        {
+            var l = new List<D3>(48);
+            double dx = NocturneConstants.SpireX - eye.x, dz = NocturneConstants.SpireZ - eye.z, dh = Math.Sqrt(dx * dx + dz * dz);
+            double azc = Math.Atan2(dx, dz);
+            for (int j = 0; j < 16; j++)
