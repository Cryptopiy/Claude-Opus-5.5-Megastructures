+        VisSubjectResult Subject(VisShotResult r, VisSubject sub, D3 eye, (double yaw, double pitch)[] poses)
+        {
+            KeyShot k = r.shot.ks;
+            var sr = new VisSubjectResult { subject = sub, proj = new VisProj[poses.Length, AspectNames.Length] };
