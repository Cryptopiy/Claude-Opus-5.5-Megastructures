+                foreach (var root in roots)
+                    foreach (var mf in root.GetComponentsInChildren<MeshFilter>(true)) if (mf.sharedMesh != null && !AssetDatabase.Contains(mf.sharedMesh)) meshesToDestroy.Add(mf.sharedMesh);
