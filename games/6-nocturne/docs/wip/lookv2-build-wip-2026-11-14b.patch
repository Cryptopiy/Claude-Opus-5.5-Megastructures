+{
+    Properties
+    {
+        _AlbedoGain ("Leaf albedo (x Moss token in v1, x Leaf in v2)", Range(0, 2)) = 0.6
+        _Smoothness ("Smoothness", Range(0, 0.95)) = 0.3
