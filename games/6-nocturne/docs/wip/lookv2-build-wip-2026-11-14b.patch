+                for (int side = -1; side <= 1; side++)
+                {
+                    double a = azc + Math.PI + side * delta * 0.98;
+                    l.Add(new D3(NocturneConstants.SpireX + r * Math.Sin(a), y, NocturneConstants.SpireZ + r * Math.Cos(a)));
+                }
+            }
+            return l;
+        }
