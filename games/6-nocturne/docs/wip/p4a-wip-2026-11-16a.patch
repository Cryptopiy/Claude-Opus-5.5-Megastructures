+                    {
+                        uint h = NocHash.H3(unchecked((uint)(i + 100000)), unchecked((uint)(b + 1000)), (uint)(f * 8 + k), 0x5249);
+                        double r = NocHash.U01(h), r2 = NocHash.U01(NocHash.H3(h, 1u, 2u, 3)), r3 = NocHash.U01(NocHash.H3(h, 4u, 5u, 6));
