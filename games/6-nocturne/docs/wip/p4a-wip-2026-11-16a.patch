+        }
+
+        // ------------------------------------------------------------------ surfaces
+        /// <summary>Footstep surface at s (14.4 "Surfaces"; the controller's own rule, NocEvents.SurfaceAt).</summary>
+        public static FootSurface SurfaceAt(double s) => NocEvents.SurfaceAt(s);
