+                        if (NocHash.U01(h) >= PGallery) continue;
+                        double r2 = NocHash.U01(NocHash.H3(h, 1u, 0u, 0)), r3 = NocHash.U01(NocHash.H3(h, 2u, 0u, 0));
+                        double r4 = NocHash.U01(NocHash.H3(h, 3u, 0u, 0)), r5 = NocHash.U01(NocHash.H3(h, 4u, 0u, 0));
