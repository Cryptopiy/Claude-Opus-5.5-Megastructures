+            for (int k = 0; k < Levels; k++)
+            {
+                double yLo = EdgeDims.LevelBottom(k), yHi = EdgeDims.LevelTop(k);
+                if (k == 0) yLo = Math.Max(yLo, EdgeDims.TerraceFirstY);
