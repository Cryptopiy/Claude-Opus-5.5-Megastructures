+            m_stepSeed = DspHash.Mix(sd ^ 0x57E9UL);
+            m_gR.Init(0.05, m_cr); m_gD.Init(0.05, m_cr); m_gH.Init(0.05, m_cr); m_gT.Init(0.05, m_cr); m_gW.Init(0.05, m_cr);
