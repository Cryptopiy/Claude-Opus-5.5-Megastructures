-                int n = (int)Math.Ceiling(2.0 * (EdgeRange + 40.0) / step) + 1;
-                u = new double[n];
-                int mid = (int)Math.Round((EdgeDims.TongueZ - z0) / step);
-                double a = 0.0;
-                for (int i = mid + 1; i < n; i++) { a += Seg(i - 1); u[i] = a; }
