+            float ramp = smoothstep(0.0, _Ramp, i.uv.x) * (1.0 - smoothstep(1.0 - _Ramp, 1.0, i.uv.x)) * smoothstep(RIBBON_NEAR0, RIBBON_NEAR1, dR);
