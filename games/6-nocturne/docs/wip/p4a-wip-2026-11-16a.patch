+                for (int j = 0; j + 1 < ys.Count; j++)
+                {
+                    if (ys[j + 1] - ys[j] < 1e-4f) continue;
+                    float zc = 0.5f * (zs[i] + zs[i + 1]), yc = 0.5f * (ys[j] + ys[j + 1]);
