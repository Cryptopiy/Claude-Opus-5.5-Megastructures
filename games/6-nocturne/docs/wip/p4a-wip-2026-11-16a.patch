+        /// </summary>
+        public static void HoledFaceX(FacadeWriter fw, double x, float nx, double z0, double z1, double y0, double y1, IList<ReliefHole> holes,
+            Func<double, double> uOfZ, uint faceId, byte mode, float uMin, float uMax)
